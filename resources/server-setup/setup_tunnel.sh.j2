#!/bin/bash

LOG_FILE="/tmp/setup_tunnel.log"
LOCK_FILE="/tmp/certbot_nginx.lock"
WEBROOT_PATH="/var/www/html"

# Derive the server's public IPv4 so nginx extra-port listeners bind only to it
# (avoids conflicting with sshd's 127.0.0.1 reverse-forward on the same port)
# Locate the ip utility
IP_CMD=""
for p in /usr/sbin/ip /sbin/ip /usr/bin/ip /bin/ip; do
    if [[ -x "$p" ]]; then IP_CMD="$p"; break; fi
done

SERVER_IP=""
if [[ -n "$IP_CMD" ]]; then
    # Method 1: source IP used to reach a public host (most reliable on single-homed VPS)
    SERVER_IP=$($IP_CMD -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.*src \([0-9.][0-9.]*\).*/\1/p' | head -1)

    # Method 2: first non-private IP with a global scope
    if [[ -z "$SERVER_IP" ]]; then
        SERVER_IP=$($IP_CMD -4 -o addr show 2>/dev/null | awk '
            /scope global/ {
                gsub(/\/.*/, "", $4)
                if ($4 !~ /^(127\.|10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.)/) {
                    print $4
                    exit
                }
            }'
        )
    fi
fi

# Method 3: fall back to hostname -I, ignoring private/loopback addresses
if [[ -z "$SERVER_IP" ]]; then
    SERVER_IP=$(/bin/hostname -I 2>/dev/null | tr ' ' '\n' | awk '
        $0 !~ /^(127\.|10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.)/ {
            print
            exit
        }'
    )
fi

# Function to write log messages to both the log file and stdout
# (stdout is captured by the NydusNet client, the file is for server-side debugging)
log() {
    local msg
    msg="$(date '+%Y-%m-%d %H:%M:%S') - $1"
    echo "$msg" | tee -a "$LOG_FILE" >/dev/null
    echo "$msg"
}

log "SERVER_IP resolved to: ${SERVER_IP:-<empty>} (methods: ip route, ip addr, hostname -I)"

# --- Main Script Logic ---
exec 2>> "$LOG_FILE"

if [[ -n "$SSH_ORIGINAL_COMMAND" ]]; then
  read -r full_hostname remote_port extra_remote_ports <<< "$SSH_ORIGINAL_COMMAND"
else
  log "ERROR: Script called without SSH_ORIGINAL_COMMAND."
  exit 1
fi

log "---"
log "START: Received request for $full_hostname on port $remote_port (extra: $extra_remote_ports)."

# Validate input
if ! [[ "$full_hostname" =~ ^[a-zA-Z0-9.-]+$ ]] || ! [[ "$remote_port" =~ ^[0-9]+$ ]]; then
  log "ERROR: Invalid hostname or port format."
  exit 1
fi

# Validate and normalize extra service ports (format: [scheme:]port, default scheme is http)
# Supported schemes: http (Nginx HTTP/WSS proxy) and raw/tcp (Nginx stream/L4 proxy)
declare -a extra_port_list=()
for token in $extra_remote_ports; do
  scheme="http"
  port="$token"
  lower_token="${token,,}"
  if [[ "$lower_token" =~ ^(raw|tcp|http): ]]; then
    scheme="${token%%:*}"
    scheme="${scheme,,}"
    port="${token#*:}"
  fi
  if ! [[ "$port" =~ ^[0-9]+$ ]]; then
    log "ERROR: Invalid extra port format: $token"
    exit 1
  fi
  extra_port_list+=("${scheme}:${port}")
done

log "Parsed extra_port_list: ${extra_port_list[*]:-<none>}"

CERT_DIR="/etc/letsencrypt/live/$full_hostname"
NGINX_CONF="/etc/nginx/sites-available/$full_hostname"
NGINX_STREAM_CONF="/etc/nginx/streams-available/$full_hostname"

# --- Locking Mechanism for Certbot and Nginx ---
log "Acquiring lock for Certbot and Nginx operations..."
(
    flock -x 200 # This command waits for an exclusive lock on the entire process

    log "Lock acquired for $full_hostname."

    # STAGE 1: Obtain Certificate if it doesn't exist
    if [ ! -d "$CERT_DIR" ]; then
        log "Certificate for $full_hostname not found. Beginning Stage 1: Validation."
        
        log "Writing temporary validation config to $NGINX_CONF."
        cat <<EOF | sudo /usr/bin/tee "$NGINX_CONF" > /dev/null
server {
    listen 80;
    server_name $full_hostname;
    location /.well-known/acme-challenge/ {
        root $WEBROOT_PATH;
    }
}
EOF
        sudo /usr/bin/ln -sfn "$NGINX_CONF" "/etc/nginx/sites-enabled/"
        log "Testing Nginx configuration..."
        if ! sudo /usr/sbin/nginx -t; then
            log "ERROR: Nginx configuration test failed. Aborting."
            exit 1
        fi
        sudo /usr/sbin/nginx -s reload
        log "Nginx reloaded with temporary config."
        sleep 1

        log "Running Certbot with --webroot authenticator..."
        sudo /usr/bin/certbot certonly --webroot -w "$WEBROOT_PATH" -d "$full_hostname" --non-interactive --agree-tos -m {{ certbot_email }}
        
        if [ $? -ne 0 ]; then
            log "ERROR: Certbot failed to obtain a certificate for $full_hostname."
            exit 1
        fi
        log "Certbot successful. Certificate obtained."
    else
        log "Certificate for $full_hostname already exists. Skipping Stage 1."
    fi

    # Log the Nginx binary compile flags so we can confirm stream support
    log "Nginx compile flags (stream/HTTP3/Lua/etc.): $(/usr/sbin/nginx -V 2>&1 | tr ' ' '\n' | grep -E '^--with-' | tr '\n' ' ')"

    # STAGE 2: Build extra service blocks (LiveKit / WebSocket / etc.)
    extra_blocks=""
    extra_locations=""
    stream_servers=""
    for spec in "${extra_port_list[@]}"; do
        scheme="${spec%%:*}"
        extra_port="${spec#*:}"

        if [[ "$scheme" == "raw" || "$scheme" == "tcp" ]]; then
            stream_servers+="
    server {
        listen ${SERVER_IP}:${extra_port};
        proxy_pass 127.0.0.1:${extra_port};
        proxy_connect_timeout 1s;
        proxy_timeout 86400;
    }
"
        else
            extra_blocks+="
server {
    listen ${SERVER_IP}:${extra_port} ssl;
    server_name $full_hostname;

    ssl_certificate /etc/letsencrypt/live/$full_hostname/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$full_hostname/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:${extra_port};
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;

        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection upgrade;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_read_timeout 86400;
    }
}
"
            extra_locations+="
    location /extraport-${extra_port}/ {
        proxy_pass http://127.0.0.1:${extra_port}/;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;

        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection upgrade;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_read_timeout 86400;
    }
"
        fi

        log "Allowing UFW for extra port ${extra_port} (${scheme})."
        sudo ufw allow ${extra_port}/tcp || log "WARN: ufw allow ${extra_port}/tcp failed"
    done

    # Write raw-TCP stream config if any
    # The file is included inside the top-level `stream` block in nginx.conf,
    # so it should only contain `server` blocks, not another `stream` context.
    if [ -n "$stream_servers" ]; then
        # Ensure stream config directories exist
        sudo /bin/mkdir -p /etc/nginx/streams-available /etc/nginx/streams-enabled || log "WARN: mkdir for stream dirs failed (may already exist)"

        log "Writing Nginx stream config to $NGINX_STREAM_CONF."
        log "Stream servers block:\n${stream_servers}"
        cat <<EOF | sudo /usr/bin/tee "$NGINX_STREAM_CONF" > /dev/null
${stream_servers}
EOF
        sudo /usr/bin/ln -sfn "$NGINX_STREAM_CONF" "/etc/nginx/streams-enabled/"
        log "Stream config symlinked to /etc/nginx/streams-enabled/."
    fi

    # STAGE 3: Create the Final HTTPS Nginx Configuration
    log "Beginning Stage 3: Writing final HTTPS configuration to $NGINX_CONF."
    cat <<EOF | sudo /usr/bin/tee "$NGINX_CONF" > /dev/null
server {
    listen 80;
    server_name $full_hostname;
    location /.well-known/acme-challenge/ {
        root $WEBROOT_PATH;
    }
    location / {
        return 301 https://\$host\$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name $full_hostname;

    ssl_certificate /etc/letsencrypt/live/$full_hostname/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/$full_hostname/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

$extra_locations

    location / {
        proxy_pass http://127.0.0.1:$remote_port;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
		
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection upgrade;
        proxy_buffering off;
        proxy_http_version 1.1;
    }
}

$extra_blocks
EOF

    log "Testing final Nginx configuration..."
    if ! sudo /usr/sbin/nginx -t; then
        log "ERROR: Final Nginx configuration test failed. Not reloading."
        exit 1
    fi
    log "Final Nginx configuration test passed."

    log "Reloading Nginx with final config."
    if ! sudo /usr/sbin/nginx -s reload; then
        log "ERROR: Nginx reload signal failed."
        exit 1
    fi
    log "Nginx reload signal sent."

    # Give Nginx a moment to bind new ports, then verify listeners
    sleep 1
    log "Verifying listening sockets for this host:"
    if command -v ss >/dev/null 2>&1; then
        extra_ports_only=""
        for p in "${extra_port_list[@]}"; do
            extra_ports_only="${extra_ports_only}${extra_ports_only:+|}${p#*:}"
        done
        listen_pattern=":(${remote_port}${extra_ports_only:+|${extra_ports_only}})"
        log "Listening check pattern: ${listen_pattern}"
        matched_listeners=$(ss -ltn | grep -E "${listen_pattern}" || true)
        if [ -n "$matched_listeners" ]; then
            log "Matched listeners:\n${matched_listeners}"
        else
            log "WARN: No listeners matched pattern ${listen_pattern}. The port may not be bound yet or may be blocked upstream."
        fi
    else
        log "ss utility not available; skipping listener verification."
    fi

) 200>"$LOCK_FILE"

log "Lock released. END: Process for $full_hostname finished successfully."
